# Copy this file to .env (same folder) and fill the values THERE, not here. .env is git-ignored and is never printed
# by the scripts; this template must stay blank. Every script (readiness.py, mail_survey.py, run.py,
# read_attachments.py) reads .env. Precedence: for the PAYBOT_* settings a variable already set in the shell wins;
# for the model variables (ANTHROPIC_*, OPENROUTER_API_KEY) this file wins, because tools that launch the scripts
# (Claude Code, IDEs) inject their own Anthropic settings and would otherwise send the key to the wrong host.
# A blank value means "not set". If a value is missing, the payment-bot checkout's .env is used as a fallback.

# --- TransportPro Public API (same values the paystatus bot uses; the scripts only ever GET) ---
PAYBOT_TP_BASE_URL=
PAYBOT_TP_USERNAME=
PAYBOT_TP_PASSWORD=

# --- Gmail, read-only, via the Google service account with domain-wide delegation ---
# Mailbox to impersonate (a member of the ratecon@ group), e.g. firstname.lastname@circledelivers.com
PAYBOT_GMAIL_USER=
# Path to the service-account JSON key. Relative paths are resolved against this folder first, then the payment-bot
# folder, so either copy the key file here or point at the existing one.
PAYBOT_GOOGLE_SA_FILE=

# --- Model access for the reader (choose ONE block) ---
# OpenRouter through its Anthropic-compatible endpoint (what the prototype has used so far):
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
# Anthropic API directly instead: leave ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN empty and set
# ANTHROPIC_API_KEY=sk-ant-...
# Non-Claude models through OpenRouter's OpenAI-compatible endpoint also accept:
# OPENROUTER_API_KEY=
